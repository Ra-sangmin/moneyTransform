/* =========================================================
   미쿠짱 견적 계산기 - 화사한 파스텔 테마 (UI Toolkit)
   기준 해상도 1920 x 1080
   ========================================================= */

/* ---------- 기본 테마 · 배경 · 그림자 · 아이콘 ---------- */

.app {
    --navy: #1F2433;
    --coral: #EC6B77;
    --coral-deep: #DD5663;
    --coral-soft: #FFF1F3;
    --pink-line: #F6D3D8;
    --line: #F0F1F5;
    --well: #F5F6F9;
    --well-line: #ECEEF3;
    --ok: #3FB07C;
    flex-grow: 1;
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/bg_cute.png");
    -unity-background-scale-mode: scale-and-crop;
    color: var(--navy);
    -unity-font-definition: url("project://database/Assets/Font/GowunDodum-Regular.ttf");
    --text-2: #4B5163;
    --text-3: #767C8E;
}

.fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bg {
    background-position-x: left 0;
    background-position-y: top 0;
}

.bg-scrim {
    background-color: rgba(255, 255, 255, 0);
}

.shadow {
    position: absolute;
    left: -44px;
    top: -32px;
    right: -44px;
    bottom: -60px;
    background-image: url("project://database/Assets/UI/Images/shadow_card.png");
    -unity-slice-left: 152;
    -unity-slice-right: 152;
    -unity-slice-top: 128;
    -unity-slice-bottom: 184;
}

.shadow--glow {
    background-image: url("project://database/Assets/UI/Images/shadow_glow.png");
}

.icon-tile {
    width: 107px;
    height: 116px;
    margin: -21px -21px -31px -21px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.icon-sm {
    width: 67px;
    height: 72px;
    margin: -13px -13px -19px -13px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.icon--rate {
    background-image: url("project://database/Assets/UI/Images/icon_rate.png");
}

.icon--quote {
    background-image: url("project://database/Assets/UI/Images/icon_quote.png");
}

.icon--msg {
    background-image: url("project://database/Assets/UI/Images/icon_msg.png");
}

.icon--total {
    background-image: url("project://database/Assets/UI/Images/icon_total.png");
}

.icon--image {
    background-image: url("project://database/Assets/UI/Images/icon_image.png");
}

.icon--edit {
    background-image: url("project://database/Assets/UI/Images/icon_edit.png");
}

.icon--trash {
    background-image: url("project://database/Assets/UI/Images/icon_trash.png");
}

.app--photo .bg-scrim {
    background-color: rgba(255, 255, 255, 0.1);
}

.icon--back {
    background-image: url("project://database/Assets/UI/Images/icon_back.png");
}

.icon--done {
    background-image: url("project://database/Assets/UI/Images/icon_done.png");
}

/* ---------- 메인 화면 · 상단 로고와 메뉴 ---------- */

.main {
    flex-grow: 1;
    padding: 30px 64px 50px 64px;
}

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.status-pill {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 40px;
    padding: 0 18px 0 14px;
    margin-top: 6px;
    border-radius: 20px;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #F4B860;
    margin-right: 10px;
}

.status-dot--ok {
    background-color: var(--ok);
}

.status-dot--error {
    background-color: var(--coral);
}

.status-text {
    -unity-font-definition: url("project://database/Assets/Font/GowunDodum-Regular.ttf");
    color: var(--coral-deep);
    margin: 0;
    padding: 0;
    margin-top: 1px;
    font-size: 20px;
    -unity-font-style: bold;
}

/* 오른쪽 위 메뉴 (사이트 상단 메뉴 느낌) */
.nav-pill {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 40px;
    padding: 6px;
}

.nav-btn {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin: 0;
    padding: 0 26px 0 14px;
    border-width: 0;
    border-radius: 32px;
    background-color: rgba(255, 255, 255, 0);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.nav-btn.unity-button:hover:enabled {
    background-color: var(--coral-soft);
}

.nav-btn.unity-button:active:enabled {
    background-color: #FFE3E7;
    scale: 0.96 0.96;
}

.nav-label {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    margin: 0 0 0 12px;
    padding: 0;
}

.columns {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 26px;
}

.col {
    flex-grow: 1;
    flex-basis: 0;
}

.col--left {
    margin-right: 36px;
}

/* 사진 위에 바로 올라가는 로고 글자만 반투명 흰 칩으로 받쳐서 읽기 쉽게 */
.app--photo .brand {
    background-color: rgba(255, 255, 255, 0.86);
    border-radius: 26px;
    padding: 10px 20px 12px 20px;
    align-self: flex-start;
}

.brand {
    flex-direction: row;
    align-items: center;
}

.brand-logo {
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Images/logo_miku.png");
    -unity-background-scale-mode: stretch-to-fill;
    width: 258px;
    height: 110px;
    margin: -17px 0 -17px -17px;
}

.brand-side {
    margin-left: 12px;
    padding-left: 18px;
    border-left-width: 2px;
    border-left-color: #F6D3D8;
}

.brand-app {
    color: var(--navy);
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    font-size: 27px;
    letter-spacing: 0;
    padding-bottom: 3px;
}

.brand-side .status-pill {
    margin-top: 6px;
}

.app .top-card {
    margin: 0;
    border-radius: 32px;
    border-width: 1.5px;
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
}

.app .brand.top-card {
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/card_brand.png");
    border-color: #F9DCE2;
    padding: 18px 32px 18px 26px;
    align-self: auto;
}

.app .nav-pill.top-card {
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/card_nav.png");
    border-color: #EAE4FA;
    padding: 8px;
}

.app .nav-pill.top-card .nav-btn.unity-button:hover:enabled {
    background-color: rgba(255, 255, 255, 0.75);
}

.app .brand.top-card .status-pill {
    background-color: rgba(255, 255, 255, 0.9);
}

.app .brand.top-card .brand-side {
    border-left-color: rgba(236, 107, 119, 0.28);
}

/* ---------- 카드 공통 ---------- */

.card {
    background-color: #FFFFFF;
    border-radius: 32px;
    border-width: 1px;
    border-color: #F4EEF0;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.card-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.card-titles {
    flex-grow: 1;
    margin-left: 20px;
}

.card-title {
    font-size: 30px;
    color: var(--navy);
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    padding-bottom: 4px;
}

.card-sub {
    margin: 2px 0 0 0;
    padding: 0;
    margin-top: 7px;
    font-size: 20px;
    color: #7C8294;
    -unity-font-style: normal;
}

.value-row {
    flex-direction: row;
    align-items: flex-end;
}

.value-unit {
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--coral);
    margin: 0 0 18px 10px;
    padding: 0;
}

.rate-card .value-row {
    justify-content: flex-end;
    margin-top: 8px;
}

.form-card .card-head {
    margin-bottom: 10px;
}

.tappable {
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}

.tappable.is-pressed {
    scale: 0.985 0.985;
    opacity: 0.92;
}

.card--rate {
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    background-image: url("project://database/Assets/UI/Images/card_rate.png");
    border-color: #E4E8FD;
}

.card--quote {
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    background-image: url("project://database/Assets/UI/Images/card_quote.png");
    border-color: #FBEBD6;
}

.card--msg {
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    background-image: url("project://database/Assets/UI/Images/card_msg.png");
    border-color: #ECE6FB;
}

.card--edit {
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    background-image: url("project://database/Assets/UI/Images/card_edit.png");
    border-color: #E4E8FD;
}

/* 파스텔 카드 위 입력칸은 반투명 흰색 */
.card--quote .field .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.82);
    border-color: #F5E2C8;
}

.card--msg .field .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.82);
    border-color: #E6DEFA;
}

.card--edit .field .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.82);
    border-color: #E0E5FB;
}

.modal .card-head {
    margin-bottom: 24px;
}

.quote-card .card-head {
    margin-bottom: 6px;
}

.rate-card .card-head .value-row {
    margin-top: 0;
    flex-shrink: 0;
}

.rate-card .value-unit {
    margin-bottom: 14px;
}

.card--rate .field .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.82);
    border-color: #DFE4FB;
}

/* ---------- 적용 환율 카드 ---------- */

.rate-value {
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
    font-size: 106px;
}

.rate-breakdown {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin: -4px 0 12px 0;
}

.rate-chip {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--text-2);
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1.5px;
    border-color: #E4E8FD;
    border-radius: 17px;
    padding: 6px 15px 7px 15px;
    margin: 0;
}

.rate-chip--add {
    color: var(--coral-deep);
    background-color: #FFF4F6;
    border-color: var(--pink-line);
}

.rate-op {
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--text-3);
    margin: 0 10px 0 10px;
    padding: 0;
}

/* 오른쪽 적용 환율 카드: 숫자를 제목 줄 오른쪽에 두어 세로를 아낌 */
.rate-card {
    padding: 26px 34px 6px 32px;
}

.rate-card .rate-value {
    font-size: 92px;
}

.rate-foot {
    flex-direction: row;
    justify-content: flex-end;
    min-height: 8px;
}

/* ---------- 견적 입력 카드 ---------- */

/* 입력 폼 카드 */
.form-card {
    padding: 28px 34px 10px 32px;
}

.form-row {
    flex-direction: row;
    align-items: center;
    height: 98px;
}

.form-row--divider {
    border-top-width: 1px;
    border-top-color: var(--line);
}

.row-label {
    flex-grow: 1;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 28px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    -unity-font-style: normal;
    color: #2A2F42;
    letter-spacing: 0.5px;
}

.row-unit {
    width: 46px;
    -unity-text-align: middle-right;
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--coral);
    margin: 0;
    padding: 0;
}

.col--left .form-card {
    flex-grow: 1;
    margin-bottom: 0;
}

.col--left .form-row {
    flex-grow: 1;
}

.field {
    margin: 0;
    padding: 0;
    --unity-cursor-color: #EC6B77;
    --unity-selection-color: rgba(236, 107, 119, 0.25);
}

.field .unity-base-text-field__input {
    background-color: var(--well);
    border-width: 1.5px;
    border-color: var(--well-line);
    border-radius: 18px;
    padding: 0 22px 0 22px;
    margin: 0;
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    -unity-text-align: middle-right;
}

.field.unity-base-text-field:hover .unity-base-text-field__input {
    border-color: var(--pink-line);
}

.field.unity-base-text-field:focus .unity-base-text-field__input {
    background-color: #FFFFFF;
    border-color: #F39AA3;
}

.field--num {
    flex-grow: 0;
    width: 280px;
}

.field--text {
    flex-grow: 1;
}

.field--text .unity-base-text-field__input {
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/Font/GowunDodum-Regular.ttf");
    font-size: 29px;
    color: #232838;
    -unity-font-style: bold;
}

.field--title {
    flex-grow: 0;
    margin-bottom: 24px;
}

.field--title .unity-base-text-field__input {
    height: 70px;
}

.field--area {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
}

.field--area .unity-base-text-field__input {
    padding: 20px 24px 20px 24px;
    -unity-font-definition: url("project://database/Assets/Font/GowunDodum-Regular.ttf");
    -unity-text-align: upper-left;
    white-space: normal;
    font-size: 29px;
    color: #232838;
    -unity-font-style: bold;
    flex-grow: 1;
    min-height: 240px;
}

.stepper {
    flex-direction: row;
    align-items: center;
    background-color: var(--well);
    border-radius: 38px;
    padding: 6px;
}

.step-btn {
    width: 64px;
    height: 64px;
    margin: 0;
    padding: 0;
    border-width: 1.5px;
    border-color: var(--well-line);
    border-radius: 32px;
    flex-shrink: 0;
    background-color: #FFFFFF;
    color: var(--coral);
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    -unity-text-align: middle-center;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.step-btn.unity-button:hover:enabled {
    background-color: var(--coral-soft);
    border-color: var(--pink-line);
}

.step-btn.unity-button:active:enabled {
    background-color: #FFE3E7;
    scale: 0.92 0.92;
}

.qty-value {
    width: 76px;
    -unity-text-align: middle-center;
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.field-label {
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    margin: 0 0 10px 4px;
    padding: 0;
    color: var(--text-2);
    -unity-font-style: bold;
    font-size: 22px;
}

.card--quote .form-row--divider {
    border-top-color: rgba(242, 164, 58, 0.16);
}

.card--msg .form-row--divider {
    border-top-color: rgba(155, 123, 227, 0.16);
}

.field .unity-base-text-field__input {
    height: 76px;
}

.field--text .unity-base-text-field__input {
    height: 70px;
}

/* 매크로 내용 입력칸은 여러 줄이 보이도록 남은 세로 공간을 모두 사용
   (위의 입력칸 높이 76px 규칙보다 뒤에 있어야 적용됨) */
.field--area .unity-base-text-field__input {
    height: auto;
}

.field--title .unity-base-text-field__input {
    font-size: 29px;
    color: #232838;
    -unity-font-style: bold;
}

/* 왼쪽 견적 입력 카드: 세로를 꽉 채우고 줄 간격을 고르게 */
.quote-card {
    flex-grow: 1;
    margin-bottom: 0;
    padding: 28px 34px 12px 32px;
}

.quote-card .form-row {
    flex-grow: 1;
    height: auto;
    min-height: 104px;
}

.row-label-box {
    flex-grow: 1;
    justify-content: center;
}

.row-label-box .row-label {
    flex-grow: 0;
    font-size: 28px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    -unity-font-style: normal;
    color: #2A2F42;
    letter-spacing: 0.5px;
}

.row-hint {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/GowunDodum-Regular.ttf");
    color: #858B9C;
    margin: 4px 0 0 4px;
    padding: 0;
    margin-top: 6px;
}

/* 대행수수료 줄: 수량 조절 + 자동 계산된 금액 */
.fee-row .stepper {
    margin-right: 14px;
    background-color: rgba(255, 255, 255, 0.82);
    border-width: 1.5px;
    border-color: #F5E2C8;
    padding: 5px;
}

.fee-row .step-btn {
    width: 60px;
    height: 60px;
    border-radius: 30px;
}

.fee-row .qty-value {
    width: 64px;
}

.fee-box {
    width: 150px;
    height: 76px;
    border-radius: 18px;
    background-color: rgba(242, 164, 58, 0.10);
    border-width: 1.5px;
    border-color: rgba(242, 164, 58, 0.18);
    justify-content: center;
    padding: 0 22px 0 0;
    flex-shrink: 0;
}

.fee-box-value {
    -unity-text-align: middle-right;
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

/* 새 견적(입력 초기화) 버튼 */
.mini-btn {
    flex-direction: row;
    align-items: center;
    height: 54px;
    margin: 0;
    padding: 0 22px 0 16px;
    border-width: 1.5px;
    border-color: #F5E2C8;
    border-radius: 27px;
    background-color: rgba(255, 255, 255, 0.9);
    flex-shrink: 0;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.mini-btn.unity-button:hover:enabled {
    background-color: #FFFFFF;
    border-color: #F2C78E;
}

.mini-btn.unity-button:active:enabled {
    background-color: #FFF4E6;
    scale: 0.95 0.95;
}

.mini-btn-icon {
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #E58A1F;
    margin: 0 8px 0 0;
    padding: 0 0 2px 0;
}

.mini-btn-label {
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #B7650E;
    margin: 0;
    padding: 0;
}

.add-rate-row {
    height: 104px;
    border-top-color: rgba(103, 128, 240, 0.16);
}

/* ---------- 최종 견적 카드 · 계산 과정 ---------- */

.result-card {
    flex-grow: 1;
    background-color: #242838;
    background-image: url("project://database/Assets/UI/Images/result_cute.png");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 32px;
    padding: 26px 36px 22px 32px;
    justify-content: flex-start;
}

.result-title {
    font-size: 30px;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    padding-bottom: 4px;
}

.result-sub {
    margin: 2px 0 0 0;
    padding: 0;
    margin-top: 7px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.66);
    -unity-font-style: normal;
}

.result-hint {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #FFFFFF;
    background-color: var(--coral);
    border-radius: 20px;
    padding: 7px 18px 8px 18px;
    margin: 0;
    align-self: flex-start;
}

.result-value-row {
    flex-direction: row;
    justify-content: flex-end;
    flex-grow: 1;
    align-items: flex-end;
    margin-bottom: 8px;
}

.result-value {
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #FFFFFF;
    margin: 0;
    padding: 0;
    font-size: 128px;
}

.result-unit {
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #FF9AA6;
    margin: 0 0 20px 12px;
    padding: 0;
    font-size: 40px;
    margin-bottom: 26px;
}

.result-actions {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
}

.calc-btn {
    height: 40px;
    margin: 0 10px 0 0;
    padding: 0 18px 0 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.calc-btn.unity-button:hover:enabled {
    background-color: rgba(255, 255, 255, 0.16);
}

.calc-btn.unity-button:active:enabled {
    background-color: rgba(255, 255, 255, 0.26);
    scale: 0.95 0.95;
}

.calc-pop {
    position: absolute;
    width: 660px;
    background-color: #FFFFFF;
    border-radius: 32px;
    border-width: 1.5px;
    border-color: #F4EEF0;
    padding: 24px 30px 16px 30px;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.calc-pop--show {
    opacity: 1;
    translate: 0 0;
}

.calc-pop-title {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    margin: 0 0 8px 0;
    padding: 0 0 4px 0;
}

.calc-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0 12px 0;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.calc-label {
    margin: 0;
    padding: 0;
    color: var(--text-2);
    -unity-font-style: bold;
    font-size: 22px;
}

.calc-value {
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.calc-value--hl {
    font-size: 25px;
    color: var(--coral);
}

.calc-arrow {
    position: absolute;
    width: 22px;
    height: 22px;
    bottom: -11px;
    background-color: #FFFFFF;
    rotate: 45deg;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-color: #F4EEF0;
}

/* 최종 견적: 남은 세로 공간을 모두 쓰고 숫자를 더 크게 */
.col .result-card {
    margin-bottom: 0;
}

/* ---------- 버튼 ---------- */

.btn {
    height: 64px;
    margin: 0;
    padding: 0 30px 0 30px;
    border-width: 0;
    border-radius: 32px;
    flex-shrink: 0;
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    -unity-text-align: middle-center;
    color: var(--navy);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.btn.unity-button:active:enabled {
    scale: 0.96 0.96;
}

.btn--outline {
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
}

.btn--outline.unity-button:hover:enabled {
    background-color: var(--coral-soft);
}

.btn--outline.unity-button:active:enabled {
    background-color: #FFE3E7;
}

.btn--ghost {
    background-color: #F2F3F7;
}

.btn--ghost.unity-button:hover:enabled {
    background-color: #E9EBF0;
}

.btn--ghost.unity-button:active:enabled {
    background-color: #DFE2E9;
}

.btn--primary {
    background-color: var(--coral);
    color: #FFFFFF;
}

.btn--primary.unity-button:hover:enabled {
    background-color: #F07C87;
}

.btn--primary.unity-button:active:enabled {
    background-color: var(--coral-deep);
}

.btn--danger {
    background-color: #EF5E6A;
    color: #FFFFFF;
}

.btn--danger.unity-button:hover:enabled {
    background-color: #F2717C;
}

.btn--danger.unity-button:active:enabled {
    background-color: #DC4C58;
}

/* 매크로 목록의 편집/삭제 */
.btn--soft {
    height: 54px;
    border-radius: 27px;
    padding: 0 26px 0 26px;
    margin-left: 10px;
    font-size: 21px;
    color: #5F74E6;
    background-color: #EEF1FE;
}

.btn--soft.unity-button:hover:enabled {
    background-color: #E2E7FD;
}

.btn--soft.unity-button:active:enabled {
    background-color: #D5DCFB;
}

.btn--soft-danger {
    color: #E0515E;
    background-color: #FFF0F2;
}

.btn--soft-danger.unity-button:hover:enabled {
    background-color: #FFE3E7;
}

.btn--soft-danger.unity-button:active:enabled {
    background-color: #FFD6DC;
}

.modal-actions .btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 68px;
    border-radius: 34px;
    margin: 0 8px 0 8px;
}

.macro-item .btn--soft {
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1.5px;
    border-color: #E1E6FC;
}

.macro-item .btn--soft-danger {
    border-color: #F9D9DE;
}

.back-btn {
    flex-direction: row;
    align-items: center;
    height: 72px;
    margin: 0;
    padding: 0 30px 0 14px;
    border-width: 1.5px;
    border-color: #F9DCE2;
    border-radius: 32px;
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/card_brand.png");
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.back-btn.unity-button:hover:enabled {
    border-color: #F3B9C2;
}

.back-btn.unity-button:active:enabled {
    scale: 0.95 0.95;
}

.back-label {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 25px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
}

/* ---------- 매크로 화면 ---------- */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/bg_cute.png");
    -unity-background-scale-mode: scale-and-crop;
}

.screen-inner {
    flex-grow: 1;
    padding: 30px 64px 40px 64px;
}

.screen-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.screen-icon {
    margin-left: 7px;
}

.screen-titles {
    flex-grow: 1;
    margin-left: 18px;
}

.screen-title {
    font-size: 38px;
    color: var(--navy);
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    padding-bottom: 4px;
}

.screen-sub {
    margin: 0;
    padding: 0;
    margin-top: 7px;
    color: var(--text-2);
    -unity-font-style: bold;
    font-size: 22px;
}

.macro-list {
    flex-grow: 1;
    margin: -20px -48px 0 -48px;
}

.macro-list .unity-scroll-view__content-container {
    padding: 20px 48px 64px 48px;
}

.macro-item {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-radius: 32px;
    border-color: #F4EEF0;
    padding: 22px 24px 22px 28px;
    margin-bottom: 22px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
}

.macro-icon {
    width: 87px;
    height: 94px;
    margin: -17px -17px -25px -17px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/UI/Images/icon_msg.png");
}

.macro-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 20px 0 20px;
}

.macro-title {
    font-size: 28px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.macro-content {
    white-space: normal;
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 24px;
    color: var(--text-2);
    -unity-font-style: bold;
    max-height: 70px;
    overflow: hidden;
}

.macro-item--empty .macro-title,
.macro-item--empty .macro-content {
    color: var(--text-3);
}

.macro-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.macro-item--purple {
    background-image: url("project://database/Assets/UI/Images/card_item_purple.png");
    border-color: #ECE6FB;
}

.macro-item--blue {
    background-image: url("project://database/Assets/UI/Images/card_item_blue.png");
    border-color: #E4E8FD;
}

.macro-item--pink {
    background-image: url("project://database/Assets/UI/Images/card_item_pink.png");
    border-color: #FAE1E9;
}

.macro-item--orange {
    background-image: url("project://database/Assets/UI/Images/card_item_orange.png");
    border-color: #FBEBD6;
}

.macro-icon--purple {
    background-image: url("project://database/Assets/UI/Images/icon_msg.png");
}

.macro-icon--blue {
    background-image: url("project://database/Assets/UI/Images/icon_msg_blue.png");
}

.macro-icon--pink {
    background-image: url("project://database/Assets/UI/Images/icon_msg_pink.png");
}

.macro-icon--orange {
    background-image: url("project://database/Assets/UI/Images/icon_msg_orange.png");
}

.title-row {
    flex-direction: row;
    align-items: center;
}

.count-chip {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--coral-deep);
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 18px;
    padding: 4px 16px 5px 16px;
    margin: 4px 0 0 14px;
}

.empty-card {
    align-self: center;
    width: 900px;
    margin-top: 60px;
    padding: 56px 60px 52px 60px;
    align-items: center;
    background-image: url("project://database/Assets/UI/Images/card_msg.png");
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    border-color: #ECE6FB;
}

.empty-icon {
    margin-bottom: 0;
}

.empty-title {
    margin: 34px 0 0 0;
    padding: 0;
    font-size: 32px;
    color: var(--navy);
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    padding-bottom: 4px;
}

.empty-sub {
    margin: 12px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--text-2);
    -unity-font-style: bold;
    font-size: 22px;
}

.macro-list .unity-scroller--vertical {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    width: 10px;
    min-width: 10px;
    max-width: 10px;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    margin: 24px 18px 64px 0;
}

.macro-list .unity-scroller__low-button,
.macro-list .unity-scroller__high-button {
    display: none;
}

.macro-list .unity-scroller__slider {
    margin: 0;
}

.macro-list .unity-base-slider__tracker {
    background-color: rgba(236, 107, 119, 0.08);
    border-width: 0;
    border-radius: 5px;
}

.macro-list .unity-base-slider__dragger {
    background-color: rgba(236, 107, 119, 0.5);
    border-width: 0;
    border-radius: 5px;
    left: 0;
    width: 10px;
}

.macro-list .unity-base-slider__dragger-border {
    display: none;
}

.msg-card {
    margin-bottom: 30px;
    flex-direction: column;
    align-items: stretch;
    flex-wrap: nowrap;
    padding: 20px 28px 20px 30px;
}

.msg-field {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    margin-left: 26px;
}

.msg-label {
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #7B5CD6;
    margin: 0 14px 0 0;
    padding: 0;
    flex-shrink: 0;
}

.macro-item--expanded .macro-content {
    max-height: none;
}

.macro-item--expanded {
    align-items: flex-start;
}

.macro-item--expanded .macro-icon {
    margin-top: -10px;
}

.macro-item--expanded .macro-actions {
    margin-top: 8px;
}

/* 항목 안 "전체 보기 / 접기" */
.macro-more {
    align-self: flex-start;
    height: 38px;
    margin: 10px 0 0 0;
    padding: 0 18px 0 18px;
    border-width: 1.5px;
    border-color: rgba(123, 92, 214, 0.22);
    border-radius: 19px;
    background-color: rgba(255, 255, 255, 0.75);
    color: #7B5CD6;
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.macro-more.unity-button:hover:enabled {
    background-color: #FFFFFF;
    border-color: rgba(123, 92, 214, 0.4);
}

.macro-more.unity-button:active:enabled {
    background-color: #F3EEFF;
    scale: 0.95 0.95;
}

/* 헤더의 "모두 펼치기 / 모두 접기" */
.expand-btn {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin: 0 16px 0 0;
    padding: 0 26px 0 22px;
    border-width: 1.5px;
    border-color: #E6DEFA;
    border-radius: 32px;
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/card_msg.png");
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
    transition-property: scale, border-color;
    transition-duration: 0.1s;
}

.expand-btn.unity-button:hover:enabled {
    border-color: #CDBEF5;
}

.expand-btn.unity-button:active:enabled {
    scale: 0.95 0.95;
}

.expand-btn--on {
    border-color: #B9A5F2;
    background-color: #F1ECFF;
    background-image: none;
}

.expand-label {
    font-size: 23px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #5B3FB8;
    margin: 0;
    padding: 0;
}

.macro-list .unity-scroller--vertical .unity-scroller__slider {
    width: 10px;
    min-width: 10px;
    max-width: 10px;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.macro-list .unity-scroller--vertical .unity-base-slider__input,
.macro-list .unity-scroller--vertical .unity-base-slider__drag-container {
    width: 10px;
    min-width: 10px;
    max-width: 10px;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
}

.macro-list .unity-scroller--vertical .unity-base-slider__tracker {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 3px;
    right: 3px;
    width: auto;
    height: auto;
    margin: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(236, 107, 119, 0.12);
}

.macro-list .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    width: 10px;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: rgba(236, 107, 119, 0.55);
}

.macro-list .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(236, 107, 119, 0.75);
}

.msg-head {
    flex-direction: row;
    align-items: center;
}

.msg-head.is-pressed {
    opacity: 0.85;
}

.msg-titles {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.msg-sub--value {
    color: #7B5CD6;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.msg-toggle {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 48px;
    padding: 0 18px 0 20px;
    margin-left: 16px;
    border-radius: 24px;
    border-width: 1.5px;
    border-color: rgba(123, 92, 214, 0.25);
    background-color: rgba(255, 255, 255, 0.85);
}

.msg-toggle-label {
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #7B5CD6;
    margin: 0 12px 0 0;
    padding: 0;
}

.msg-chevron {
    width: 11px;
    height: 11px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: #9B7BE3;
    rotate: 45deg;
    margin-top: -5px;
    transition-property: rotate, margin-top;
    transition-duration: 0.15s;
}

.msg-card--open .msg-chevron {
    rotate: -135deg;
    margin-top: 5px;
}

.msg-body {
    flex-direction: row;
    align-items: center;
    margin: 18px 0 4px -26px;
}

.expand-icon {
    width: 24px;
    height: 26px;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.expand-chevron {
    width: 12px;
    height: 12px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: #8A69DF;
    rotate: 45deg;
    margin-top: -6px;
    transition-property: rotate, margin-top;
    transition-duration: 0.15s;
}

.expand-chevron--2 {
    margin-top: -4px;
}

/* 모두 펼친 상태 → 버튼은 "접기" 이므로 화살표를 위로 */
.expand-btn--on .expand-chevron {
    rotate: -135deg;
    margin-top: 2px;
}

.expand-btn--on .expand-chevron--2 {
    margin-top: -4px;
}

.expand-label-short {
    display: none;
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: #5B3FB8;
    margin: 0;
    padding: 0;
}

/* ---------- 매크로 편집 화면 ---------- */

.edit-card {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 30px 36px 28px 36px;
    margin-bottom: 0;
}

.token-bar {
    flex-direction: row;
    align-items: center;
    margin-top: 22px;
    flex-shrink: 0;
}

.token-label {
    margin: 0 16px 0 4px;
    padding: 0;
    color: var(--text-2);
    -unity-font-style: bold;
    font-size: 22px;
}

.token-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
}

.token {
    height: 52px;
    margin: 0 10px 0 0;
    padding: 0 22px 0 22px;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 26px;
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--coral-deep);
    background-color: var(--coral-soft);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.token.unity-button:hover:enabled {
    background-color: #FFE3E7;
}

.token.unity-button:active:enabled {
    background-color: #FFD6DC;
    scale: 0.95 0.95;
}

/* ---------- 팝업 · 토스트 · 배경 사진 창 ---------- */

.modal-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(31, 36, 51, 0.38);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.modal-scrim--show {
    opacity: 1;
}

.modal {
    width: 720px;
    background-color: #FFFFFF;
    border-radius: 32px;
    padding: 50px 40px 34px 40px;
    scale: 0.95 0.95;
    transition-property: scale;
    transition-duration: 0.18s;
    background-image: url("project://database/Assets/UI/Images/card_modal.png");
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    border-color: #FBE3E6;
}

.modal-scrim--show .modal {
    scale: 1 1;
}

.modal-message {
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--navy);
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 0 0 40px 0;
    padding: 0;
    font-size: 31px;
}

.modal-actions {
    flex-direction: row;
    justify-content: center;
}

.toast-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 96px;
    align-items: center;
    opacity: 0;
    translate: 0 24px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.toast-wrap--show {
    opacity: 1;
    translate: 0 0;
}

.toast-wrap--hide {
    opacity: 0;
    translate: 0 -30px;
    transition-duration: 0.6s;
}

.toast {
    background-color: var(--navy);
    color: #FFFFFF;
    font-size: 25px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    border-radius: 36px;
    padding: 18px 40px 20px 40px;
    margin: 0;
}

.modal-icon {
    align-self: center;
    margin: -21px -21px -3px -21px;
}

.modal--wide {
    width: 940px;
    padding: 40px 40px 34px 40px;
}

/* 배경 사진 미리보기 */
.bg-preview {
    height: 330px;
    border-radius: 24px;
    border-width: 1.5px;
    border-color: #F1E6EA;
    background-color: #FFFFFF;
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.bg-preview--default {
    background-image: url("project://database/Assets/UI/Images/bg_cute.png");
}

.bg-preview-chip {
    position: absolute;
    left: 18px;
    top: 18px;
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/CookieRun-Bold.ttf");
    color: var(--coral-deep);
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 18px;
    padding: 5px 16px 6px 16px;
    margin: 0;
}

.bg-hint {
    -unity-text-align: middle-center;
    margin: 16px 0 28px 0;
    padding: 0;
    color: var(--text-2);
    -unity-font-style: bold;
    font-size: 22px;
}

/* ---------- 세로 화면 (아이폰): 화면이 세로로 길면 MainController 가 .app 에 .portrait 를 붙임 (기준 900 x 1600) ---------- */

.portrait .main {
    padding: 20px 28px 28px 28px;
}

.portrait .brand-logo {
    width: 224px;
    height: 95px;
    margin: -15px -15px -15px -15px;
}

.portrait .brand-side {
    margin-left: 10px;
    padding-left: 14px;
}

.portrait .brand-app {
    font-size: 24px;
}

/* 오른쪽 위 메뉴는 아이콘만 */
.portrait .nav-label {
    display: none;
}

.portrait .nav-btn {
    padding: 0 10px 0 10px;
}

.portrait .columns {
    flex-direction: column;
    margin-top: 22px;
}

.portrait .col--left {
    flex-basis: auto;
    margin-right: 0;
    margin-bottom: 22px;
}

.portrait .col {
    flex-basis: auto;
    flex-grow: 0;
}

.portrait .quote-card {
    padding: 24px 28px 8px 28px;
    flex-grow: 1;
}

.portrait .field--num {
    width: 300px;
}

.portrait .rate-card {
    margin-bottom: 22px;
    padding: 24px 28px 6px 28px;
}

.portrait .rate-card .rate-value {
    font-size: 84px;
}

.portrait .add-rate-row {
    height: 112px;
}

.portrait .result-card {
    padding: 26px 30px 22px 28px;
    flex-grow: 0;
    height: 440px;
    min-height: 440px;
}

.portrait .result-head {
    flex-wrap: wrap;
}

.portrait .result-value {
    font-size: 124px;
}

.portrait .screen-inner {
    padding: 20px 28px 28px 28px;
}

.portrait .screen-icon,
.portrait .screen-sub,
.portrait .expand-label {
    display: none;
}

.portrait .screen-titles {
    margin-left: 18px;
}

.portrait .expand-btn {
    margin-right: 12px;
    padding: 0 20px 0 16px;
}

.portrait .screen-header .btn--primary {
    padding: 0 24px 0 24px;
}

.portrait .msg-field {
    flex-basis: 100%;
    flex-grow: 0;
    width: 100%;
    margin: 18px 0 0 0;
}

/* ---------- 매크로 화면 (이어서) ---------- */

.msg-body .msg-field {
    flex-basis: 0;
    flex-grow: 1;
    width: auto;
    margin: 0 0 0 26px;
}

/* ---------- 세로 화면 (아이폰): 화면이 세로로 길면 MainController 가 .app 에 .portrait 를 붙임 (기준 900 x 1600) (이어서) ---------- */

.portrait .msg-label {
    width: 86px;
}

.portrait .macro-list {
    margin: -20px -28px 0 -28px;
}

.portrait .macro-list .unity-scroll-view__content-container {
    padding: 20px 28px 64px 28px;
}

.portrait .macro-list .unity-scroller--vertical {
    margin: 24px 8px 64px 0;
}

.portrait .macro-item {
    padding: 22px 20px 22px 26px;
}

.portrait .macro-text {
    margin: 0 14px 0 18px;
}

.portrait .empty-card {
    width: auto;
    align-self: stretch;
    padding: 48px 36px 44px 36px;
}

.portrait .modal,
.portrait .modal--wide {
    width: 820px;
}

.portrait .col--left {
    flex-grow: 1;
}

.portrait .quote-card .form-row {
    flex-grow: 1;
    height: auto;
    min-height: 112px;
    max-height: none;
}

.portrait .row-label,
.portrait .row-label-box .row-label {
    font-size: 32px;
}

.portrait .row-hint {
    font-size: 21px;
}

.portrait .field .unity-base-text-field__input {
    height: 92px;
    font-size: 36px;
    border-radius: 22px;
}

.portrait .fee-box {
    height: 92px;
    border-radius: 22px;
}

.portrait .fee-box-value {
    font-size: 36px;
}

.portrait .fee-row .step-btn {
    width: 70px;
    height: 70px;
    border-radius: 35px;
}

.portrait .row-unit {
    font-size: 28px;
}

.portrait .fee-row .stepper {
    border-radius: 42px;
}

.portrait .card-title,
.portrait .result-title {
    font-size: 34px;
}

.portrait .card-sub,
.portrait .result-sub {
    font-size: 22px;
}

.portrait .calc-btn {
    font-size: 22px;
    height: 48px;
    border-radius: 24px;
}

.portrait .result-hint {
    font-size: 22px;
}

.portrait .field--area .unity-base-text-field__input {
    font-size: 32px;
}

/* 세로 화면: 자동 입력 버튼이 넘치면 다음 줄로 */
.portrait .token-bar,
.portrait .token-row {
    flex-wrap: wrap;
}

.portrait .msg-card {
    flex-direction: column;
    align-items: stretch;
    flex-wrap: nowrap;
    padding: 20px 28px 20px 30px;
}

.portrait .msg-titles {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

/* 세로 화면: 문구 1, 문구 2 를 한 줄씩 */
.portrait .msg-body {
    flex-direction: column;
    align-items: stretch;
    margin: 18px 0 4px 0;
}

.portrait .msg-body .msg-field {
    flex-basis: auto;
    flex-grow: 0;
    width: auto;
    margin: 0 0 14px 0;
}

/* 세로 화면: 짧은 글자(펼치기/접기)와 아이콘을 함께 보여 줌 */
.portrait .expand-label-short {
    display: flex;
}

.portrait .expand-icon {
    margin-right: 8px;
}
