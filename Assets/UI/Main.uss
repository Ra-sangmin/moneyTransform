/* =========================================================
   미쿠짱 견적 계산기 - 화사한 파스텔 테마 (UI Toolkit)
   기준 해상도 1920 x 1080
   ========================================================= */

.app {
    --navy: #1F2433;
    --text-2: #6B7182;
    --text-3: #A3A8B6;
    --coral: #EC6B77;
    --coral-deep: #DD5663;
    --coral-soft: #FFF1F3;
    --pink-line: #F6D3D8;
    --line: #F0F1F5;
    --well: #F5F6F9;
    --well-line: #ECEEF3;
    --ok: #3FB07C;

    flex-grow: 1;
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/bg_cute.png");
    -unity-background-scale-mode: scale-and-crop;
    color: var(--navy);
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundR.ttf");
}

.fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- 배경 사진 ---------- */
.bg {
    background-position-x: left 0;
    background-position-y: top 0;
}

.bg-scrim {
    background-color: rgba(255, 255, 255, 0);
}

.app--photo .bg-scrim {
    background-color: rgba(255, 255, 255, 0.55);
}

/* ---------- 그림자 (코드에서 카드마다 자동 추가) ---------- */
.shadow {
    position: absolute;
    left: -44px;
    top: -32px;
    right: -44px;
    bottom: -60px;
    background-image: url("project://database/Assets/UI/Images/shadow_card.png");
    -unity-slice-left: 152;
    -unity-slice-right: 152;
    -unity-slice-top: 128;
    -unity-slice-bottom: 184;
}

.shadow--glow {
    background-image: url("project://database/Assets/UI/Images/shadow_glow.png");
}

/* ---------- 광택 아이콘 타일 (이미지에 글로우 여백 포함) ---------- */
.icon-tile {
    width: 107px;
    height: 116px;
    margin: -21px -21px -31px -21px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.icon-sm {
    width: 67px;
    height: 72px;
    margin: -13px -13px -19px -13px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.icon--rate { background-image: url("project://database/Assets/UI/Images/icon_rate.png"); }
.icon--quote { background-image: url("project://database/Assets/UI/Images/icon_quote.png"); }
.icon--fee { background-image: url("project://database/Assets/UI/Images/icon_fee.png"); }
.icon--msg { background-image: url("project://database/Assets/UI/Images/icon_msg.png"); }
.icon--total { background-image: url("project://database/Assets/UI/Images/icon_total.png"); }
.icon--image { background-image: url("project://database/Assets/UI/Images/icon_image.png"); }
.icon--edit { background-image: url("project://database/Assets/UI/Images/icon_edit.png"); }

/* ---------- 메인 레이아웃 ---------- */
.main {
    flex-grow: 1;
    padding: 30px 64px 50px 64px;
}

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.brand-row {
    flex-direction: row;
    align-items: flex-end;
}

.brand-name {
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Font/Jalnan.ttf");
    color: var(--coral);
    margin: 0;
    padding: 0;
}

.brand-app {
    font-size: 28px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0 0 8px 12px;
    padding: 0;
}

.status-pill {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 40px;
    padding: 0 18px 0 14px;
    margin-top: 6px;
    border-radius: 20px;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #F4B860;
    margin-right: 10px;
}

.status-dot--ok {
    background-color: var(--ok);
}

.status-dot--error {
    background-color: var(--coral);
}

.status-text {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundR.ttf");
    color: var(--coral-deep);
    margin: 0;
    padding: 0;
}

/* 오른쪽 위 메뉴 (사이트 상단 메뉴 느낌) */
.nav-pill {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 40px;
    padding: 6px;
}

.nav-btn {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin: 0;
    padding: 0 26px 0 14px;
    border-width: 0;
    border-radius: 32px;
    background-color: rgba(255, 255, 255, 0);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.nav-btn.unity-button:hover:enabled {
    background-color: var(--coral-soft);
}

.nav-btn.unity-button:active:enabled {
    background-color: #FFE3E7;
    scale: 0.96 0.96;
}

.nav-label {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0 0 0 12px;
    padding: 0;
}

.columns {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 30px;
}

.col {
    flex-grow: 1;
    flex-basis: 0;
}

.col--left {
    margin-right: 36px;
}

/* ---------- 카드 ---------- */
.card {
    background-color: #FFFFFF;
    border-radius: 32px;
    border-width: 1px;
    border-color: #F4EEF0;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.card-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.card-titles {
    flex-grow: 1;
    margin-left: 20px;
}

.card-title {
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.card-sub {
    font-size: 19px;
    color: var(--text-3);
    margin: 2px 0 0 0;
    padding: 0;
}

.value-row {
    flex-direction: row;
    align-items: flex-end;
}

.value-unit {
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--coral);
    margin: 0 0 18px 10px;
    padding: 0;
}

.value-unit--sm {
    font-size: 24px;
    margin-bottom: 8px;
}

/* 환율 카드 */
.rate-card {
    padding: 28px 36px 14px 32px;
}

.rate-card .value-row {
    justify-content: flex-end;
    margin-top: -6px;
}

.rate-value {
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

/* 입력 폼 카드 */
.form-card {
    padding: 28px 34px 10px 32px;
}

.form-row {
    flex-direction: row;
    align-items: center;
    height: 84px;
}

.form-card .card-head {
    margin-bottom: 10px;
}

.form-row--divider {
    border-top-width: 1px;
    border-top-color: var(--line);
}

.row-label {
    flex-grow: 1;
    font-size: 27px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundR.ttf");
    color: var(--navy);
    margin: 0 0 0 4px;
    padding: 0;
}

.form-row--text {
    height: 76px;
}

.form-row--text .row-label {
    flex-grow: 0;
    width: 110px;
    color: var(--text-2);
}

.row-unit {
    width: 46px;
    -unity-text-align: middle-right;
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--coral);
    margin: 0;
    padding: 0;
}

.col--left .form-card {
    flex-grow: 1;
    margin-bottom: 0;
}

.col--left .form-row {
    flex-grow: 1;
}

/* ---------- 입력칸 (TextField) ---------- */
.field {
    margin: 0;
    padding: 0;
    --unity-cursor-color: #EC6B77;
    --unity-selection-color: rgba(236, 107, 119, 0.25);
}

.field .unity-base-text-field__input {
    background-color: var(--well);
    border-width: 1.5px;
    border-color: var(--well-line);
    border-radius: 18px;
    height: 62px;
    padding: 0 22px 0 22px;
    margin: 0;
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    -unity-text-align: middle-right;
}

.field.unity-base-text-field:hover .unity-base-text-field__input {
    border-color: var(--pink-line);
}

.field.unity-base-text-field:focus .unity-base-text-field__input {
    background-color: #FFFFFF;
    border-color: #F39AA3;
}

.field--num {
    width: 290px;
    flex-grow: 0;
}

.field--text {
    flex-grow: 1;
}

.field--text .unity-base-text-field__input {
    -unity-text-align: middle-left;
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundR.ttf");
    height: 58px;
}

.field--title {
    flex-grow: 0;
    margin-bottom: 24px;
}

.field--title .unity-base-text-field__input {
    height: 70px;
    font-size: 30px;
}

.field--area {
    flex-grow: 1;
}

.field--area .unity-base-text-field__input {
    flex-grow: 1;
    height: auto;
    padding: 20px 24px 20px 24px;
    font-size: 28px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundR.ttf");
    -unity-text-align: upper-left;
    white-space: normal;
}

/* ---------- 대행수수료 카드 ---------- */
.fee-card {
    flex-direction: row;
    align-items: center;
    padding: 24px 26px 24px 32px;
}

.fee-value-row {
    margin-top: -4px;
}

.fee-value {
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.stepper-wrap {
    align-items: center;
    flex-shrink: 0;
}

.stepper-label {
    font-size: 18px;
    color: var(--text-3);
    margin: 0 0 6px 0;
    padding: 0;
}

.stepper {
    flex-direction: row;
    align-items: center;
    background-color: var(--well);
    border-radius: 38px;
    padding: 6px;
}

.step-btn {
    width: 64px;
    height: 64px;
    margin: 0;
    padding: 0;
    border-width: 1.5px;
    border-color: var(--well-line);
    border-radius: 32px;
    flex-shrink: 0;
    background-color: #FFFFFF;
    color: var(--coral);
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    -unity-text-align: middle-center;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.step-btn.unity-button:hover:enabled {
    background-color: var(--coral-soft);
    border-color: var(--pink-line);
}

.step-btn.unity-button:active:enabled {
    background-color: #FFE3E7;
    scale: 0.92 0.92;
}

.qty-value {
    width: 76px;
    -unity-text-align: middle-center;
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

/* ---------- 합계 카드 (네이비 포인트) ---------- */
.result-card {
    flex-grow: 1;
    background-color: #242838;
    background-image: url("project://database/Assets/UI/Images/result_cute.png");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 32px;
    padding: 26px 36px 22px 32px;
    justify-content: space-between;
}

.result-title {
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: #FFFFFF;
    margin: 0;
    padding: 0;
}

.result-sub {
    font-size: 19px;
    color: rgba(255, 255, 255, 0.55);
    margin: 2px 0 0 0;
    padding: 0;
}

.result-hint {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: #FFFFFF;
    background-color: var(--coral);
    border-radius: 20px;
    padding: 7px 18px 8px 18px;
    margin: 0;
    align-self: flex-start;
}

.result-value-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
}

.result-value {
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: #FFFFFF;
    margin: 0;
    padding: 0;
}

.result-unit {
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: #FF9AA6;
    margin: 0 0 20px 12px;
    padding: 0;
}

.result-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin: 2px 0 12px 0;
    flex-shrink: 0;
}

.result-formula {
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundR.ttf");
    color: rgba(255, 255, 255, 0.82);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.result-guide {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.42);
    white-space: normal;
    margin: 4px 0 0 0;
    padding: 0;
}

/* ---------- 탭 가능한 카드 공통 ---------- */
.tappable {
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}

.tappable.is-pressed {
    scale: 0.985 0.985;
    opacity: 0.92;
}

/* ---------- 버튼 ---------- */
.btn {
    height: 64px;
    margin: 0;
    padding: 0 30px 0 30px;
    border-width: 0;
    border-radius: 32px;
    flex-shrink: 0;
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    -unity-text-align: middle-center;
    color: var(--navy);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.btn.unity-button:active:enabled {
    scale: 0.96 0.96;
}

.btn--outline {
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
}

.btn--outline.unity-button:hover:enabled {
    background-color: var(--coral-soft);
}

.btn--outline.unity-button:active:enabled {
    background-color: #FFE3E7;
}

.btn--ghost {
    background-color: #F2F3F7;
}

.btn--ghost.unity-button:hover:enabled {
    background-color: #E9EBF0;
}

.btn--ghost.unity-button:active:enabled {
    background-color: #DFE2E9;
}

.btn--primary {
    background-color: var(--coral);
    color: #FFFFFF;
}

.btn--primary.unity-button:hover:enabled {
    background-color: #F07C87;
}

.btn--primary.unity-button:active:enabled {
    background-color: var(--coral-deep);
}

.btn--danger {
    background-color: #EF5E6A;
    color: #FFFFFF;
}

.btn--danger.unity-button:hover:enabled {
    background-color: #F2717C;
}

.btn--danger.unity-button:active:enabled {
    background-color: #DC4C58;
}

/* 매크로 목록의 편집/삭제 */
.btn--soft {
    height: 54px;
    border-radius: 27px;
    padding: 0 26px 0 26px;
    margin-left: 10px;
    font-size: 21px;
    color: #5F74E6;
    background-color: #EEF1FE;
}

.btn--soft.unity-button:hover:enabled {
    background-color: #E2E7FD;
}

.btn--soft.unity-button:active:enabled {
    background-color: #D5DCFB;
}

.btn--soft-danger {
    color: #E0515E;
    background-color: #FFF0F2;
}

.btn--soft-danger.unity-button:hover:enabled {
    background-color: #FFE3E7;
}

.btn--soft-danger.unity-button:active:enabled {
    background-color: #FFD6DC;
}

/* ---------- 매크로/편집 화면 ---------- */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #FFFFFF;
    background-image: url("project://database/Assets/UI/Images/bg_cute.png");
    -unity-background-scale-mode: scale-and-crop;
}

.screen-inner {
    flex-grow: 1;
    padding: 30px 64px 40px 64px;
}

.screen-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.screen-icon {
    margin-left: 7px;
}

.screen-titles {
    flex-grow: 1;
    margin-left: 18px;
}

.screen-title {
    font-size: 38px;
    -unity-font-definition: url("project://database/Assets/Font/Jalnan.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.screen-sub {
    font-size: 20px;
    color: var(--text-3);
    margin: 0;
    padding: 0;
}

.macro-list {
    flex-grow: 1;
    margin: -20px -48px 0 -48px;
}

.macro-list .unity-scroll-view__content-container {
    padding: 20px 48px 64px 48px;
}

.macro-item {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-radius: 32px;
    border-width: 1px;
    border-color: #F4EEF0;
    padding: 22px 24px 22px 28px;
    margin-bottom: 22px;
}

.macro-icon {
    width: 87px;
    height: 94px;
    margin: -17px -17px -25px -17px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/UI/Images/icon_msg.png");
}

.macro-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 20px 0 20px;
}

.macro-title {
    font-size: 28px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.macro-content {
    font-size: 22px;
    color: var(--text-2);
    white-space: normal;
    max-height: 66px;
    overflow: hidden;
    margin: 4px 0 0 0;
    padding: 0;
}

.macro-item--empty .macro-title,
.macro-item--empty .macro-content {
    color: var(--text-3);
}

.macro-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.empty {
    margin-top: 140px;
    font-size: 26px;
    color: var(--text-2);
    -unity-text-align: middle-center;
    white-space: normal;
}

.edit-card {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 30px 36px 28px 36px;
    margin-bottom: 0;
}

.field-label {
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--text-2);
    margin: 0 0 10px 4px;
    padding: 0;
}

.token-bar {
    flex-direction: row;
    align-items: center;
    margin-top: 22px;
    flex-shrink: 0;
}

.token-label {
    font-size: 20px;
    color: var(--text-3);
    margin: 0 16px 0 4px;
    padding: 0;
}

.token-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
}

.token {
    height: 52px;
    margin: 0 10px 0 0;
    padding: 0 22px 0 22px;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 26px;
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--coral-deep);
    background-color: var(--coral-soft);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.token.unity-button:hover:enabled {
    background-color: #FFE3E7;
}

.token.unity-button:active:enabled {
    background-color: #FFD6DC;
    scale: 0.95 0.95;
}

/* ---------- 확인 팝업 ---------- */
.modal-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(31, 36, 51, 0.38);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.modal-scrim--show {
    opacity: 1;
}

.modal {
    width: 720px;
    background-color: #FFFFFF;
    border-radius: 32px;
    padding: 50px 40px 34px 40px;
    scale: 0.95 0.95;
    transition-property: scale;
    transition-duration: 0.18s;
}

.modal-scrim--show .modal {
    scale: 1 1;
}

.modal-message {
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 0 0 40px 0;
    padding: 0;
}

.modal-actions {
    flex-direction: row;
    justify-content: center;
}

.modal-actions .btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 68px;
    border-radius: 34px;
    margin: 0 8px 0 8px;
}

/* ---------- 토스트 알림 ---------- */
.toast-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 96px;
    align-items: center;
    opacity: 0;
    translate: 0 24px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.toast-wrap--show {
    opacity: 1;
    translate: 0 0;
}

.toast-wrap--hide {
    opacity: 0;
    translate: 0 -30px;
    transition-duration: 0.6s;
}

.toast {
    background-color: var(--navy);
    color: #FFFFFF;
    font-size: 25px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    border-radius: 36px;
    padding: 18px 40px 20px 40px;
    margin: 0;
}

/* ---------- 카드별 파스텔 배경 (아이콘 색과 맞춤) ---------- */
.card--rate,
.card--quote,
.card--fee,
.card--msg,
.card--edit {
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
}

.card--rate {
    background-image: url("project://database/Assets/UI/Images/card_rate.png");
    border-color: #E4E8FD;
}

.card--quote {
    background-image: url("project://database/Assets/UI/Images/card_quote.png");
    border-color: #FBEBD6;
}

.card--fee {
    background-image: url("project://database/Assets/UI/Images/card_fee.png");
    border-color: #FAE1E9;
}

.card--msg {
    background-image: url("project://database/Assets/UI/Images/card_msg.png");
    border-color: #ECE6FB;
}

.card--edit {
    background-image: url("project://database/Assets/UI/Images/card_edit.png");
    border-color: #E4E8FD;
}

/* 파스텔 카드 위 입력칸은 반투명 흰색 */
.card--quote .field .unity-base-text-field__input,
.card--msg .field .unity-base-text-field__input,
.card--edit .field .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.82);
}

.card--quote .field .unity-base-text-field__input {
    border-color: #F5E2C8;
}

.card--msg .field .unity-base-text-field__input {
    border-color: #E6DEFA;
}

.card--edit .field .unity-base-text-field__input {
    border-color: #E0E5FB;
}

.card--quote .form-row--divider {
    border-top-color: rgba(242, 164, 58, 0.16);
}

.card--msg .form-row--divider {
    border-top-color: rgba(155, 123, 227, 0.16);
}

.card--fee .stepper {
    background-color: rgba(255, 255, 255, 0.75);
    border-width: 1.5px;
    border-color: #F7DCE5;
}

/* ---------- 매크로 목록: 항목마다 색이 돌아가며 바뀜 ---------- */
.macro-item {
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
}

.macro-item--purple {
    background-image: url("project://database/Assets/UI/Images/card_item_purple.png");
    border-color: #ECE6FB;
}

.macro-item--blue {
    background-image: url("project://database/Assets/UI/Images/card_item_blue.png");
    border-color: #E4E8FD;
}

.macro-item--pink {
    background-image: url("project://database/Assets/UI/Images/card_item_pink.png");
    border-color: #FAE1E9;
}

.macro-item--orange {
    background-image: url("project://database/Assets/UI/Images/card_item_orange.png");
    border-color: #FBEBD6;
}

.macro-icon--purple { background-image: url("project://database/Assets/UI/Images/icon_msg.png"); }
.macro-icon--blue { background-image: url("project://database/Assets/UI/Images/icon_msg_blue.png"); }
.macro-icon--pink { background-image: url("project://database/Assets/UI/Images/icon_msg_pink.png"); }
.macro-icon--orange { background-image: url("project://database/Assets/UI/Images/icon_msg_orange.png"); }

.macro-item .btn--soft {
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1.5px;
    border-color: #E1E6FC;
}

.macro-item .btn--soft-danger {
    border-color: #F9D9DE;
}

.title-row {
    flex-direction: row;
    align-items: center;
}

.count-chip {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--coral-deep);
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 18px;
    padding: 4px 16px 5px 16px;
    margin: 4px 0 0 14px;
}

.empty-card {
    align-self: center;
    width: 900px;
    margin-top: 60px;
    padding: 56px 60px 52px 60px;
    align-items: center;
    background-image: url("project://database/Assets/UI/Images/card_msg.png");
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    border-color: #ECE6FB;
}

.empty-icon {
    margin-bottom: 0;
}

.empty-title {
    margin: 34px 0 0 0;
    padding: 0;
    font-size: 32px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
}

.empty-sub {
    margin: 12px 0 0 0;
    padding: 0;
    font-size: 22px;
    color: var(--text-2);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- 팝업 공통: 코랄 빛 배경 + 아이콘 ---------- */
.icon--trash { background-image: url("project://database/Assets/UI/Images/icon_trash.png"); }

.modal {
    background-image: url("project://database/Assets/UI/Images/card_modal.png");
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1.5px;
    border-color: #FBE3E6;
}

.modal-icon {
    align-self: center;
    margin: -21px -21px -3px -21px;
}

.modal--wide {
    width: 940px;
    padding: 40px 40px 34px 40px;
}

.modal .card-head {
    margin-bottom: 24px;
}

/* 배경 사진 미리보기 */
.bg-preview {
    height: 330px;
    border-radius: 24px;
    border-width: 1.5px;
    border-color: #F1E6EA;
    background-color: #FFFFFF;
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.bg-preview--default {
    background-image: url("project://database/Assets/UI/Images/bg_cute.png");
}

.bg-preview-chip {
    position: absolute;
    left: 18px;
    top: 18px;
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--coral-deep);
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: var(--pink-line);
    border-radius: 18px;
    padding: 5px 16px 6px 16px;
    margin: 0;
}

.bg-hint {
    font-size: 20px;
    color: var(--text-3);
    -unity-text-align: middle-center;
    margin: 16px 0 28px 0;
    padding: 0;
}

/* ---------- 글꼴: 제목은 잘난체(귀여운 제목체), 본문은 나눔스퀘어라운드 ---------- */
.card-title,
.result-title,
.screen-title,
.empty-title {
    -unity-font-definition: url("project://database/Assets/Font/Jalnan.ttf");
}

/* ---------- 나눔스퀘어라운드 글꼴에 맞춘 간격 조정 ---------- */
.card-sub,
.result-sub,
.screen-sub {
    margin-top: 7px;
}

.rate-card .value-row {
    margin-top: 8px;
}

.rate-value {
    font-size: 106px;
}

.fee-value-row {
    margin-top: 6px;
}

.result-card {
    justify-content: flex-start;
}

.result-value-row {
    flex-grow: 1;
    align-items: flex-end;
    margin-bottom: 8px;
}

.result-guide {
    margin-top: 6px;
}

.status-text {
    margin-top: 1px;
}

.card-title,
.result-title,
.screen-title,
.empty-title {
    padding-bottom: 4px;
}

.brand-name {
    padding-bottom: 2px;
}

/* ---------- 계산 과정 보기 (누르고 있는 동안만 표시) ---------- */
.result-actions {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
}

.calc-btn {
    height: 40px;
    margin: 0 10px 0 0;
    padding: 0 18px 0 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.calc-btn.unity-button:hover:enabled {
    background-color: rgba(255, 255, 255, 0.16);
}

.calc-btn.unity-button:active:enabled {
    background-color: rgba(255, 255, 255, 0.26);
    scale: 0.95 0.95;
}

.calc-pop {
    position: absolute;
    width: 660px;
    background-color: #FFFFFF;
    border-radius: 32px;
    border-width: 1.5px;
    border-color: #F4EEF0;
    padding: 24px 30px 16px 30px;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.calc-pop--show {
    opacity: 1;
    translate: 0 0;
}

.calc-pop-title {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Font/Jalnan.ttf");
    color: var(--navy);
    margin: 0 0 8px 0;
    padding: 0 0 4px 0;
}

.calc-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0 12px 0;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.calc-label {
    font-size: 19px;
    color: var(--text-2);
    margin: 0;
    padding: 0;
}

.calc-value {
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--navy);
    margin: 0;
    padding: 0;
}

.calc-value--hl {
    font-size: 25px;
    color: var(--coral);
}

.calc-arrow {
    position: absolute;
    width: 22px;
    height: 22px;
    bottom: -11px;
    background-color: #FFFFFF;
    rotate: 45deg;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-color: #F4EEF0;
}

/* ---------- 엔화 환율: 기준 + 추가 = 적용 환율 ---------- */
.rate-breakdown {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin: 0 0 8px 0;
}

.rate-chip {
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--text-2);
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1.5px;
    border-color: #E4E8FD;
    border-radius: 17px;
    padding: 6px 15px 7px 15px;
    margin: 0;
}

.rate-chip--add {
    color: var(--coral-deep);
    background-color: #FFF4F6;
    border-color: var(--pink-line);
}

.rate-op {
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Font/NanumSquareRoundEB.ttf");
    color: var(--text-3);
    margin: 0 10px 0 10px;
    padding: 0;
}

/* ---------- 배경 사진을 선명하게: 흰 막을 아주 옅게 ---------- */
.app--photo .bg-scrim {
    background-color: rgba(255, 255, 255, 0.1);
}

/* 사진 위에 바로 올라가는 로고 글자만 반투명 흰 칩으로 받쳐서 읽기 쉽게 */
.app--photo .brand {
    background-color: rgba(255, 255, 255, 0.86);
    border-radius: 26px;
    padding: 10px 20px 12px 20px;
    align-self: flex-start;
}
